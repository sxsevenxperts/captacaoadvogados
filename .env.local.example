# Copie este arquivo para .env.local e preencha com suas credenciais
# Encontre esses valores em: Supabase Dashboard → seu projeto → Settings → API

# URL do seu projeto Supabase (https://...supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto-aqui.supabase.co

# Chave anônima (public) - pode estar em código frontend
# Não adicione a chave de serviço (service_role_key) aqui!
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
