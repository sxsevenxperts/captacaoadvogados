# Copie para .env.local e preencha.
# Valores em: Supabase Dashboard -> seu projeto -> Settings -> API

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Use a chave "anon" / "publishable". Ela vai para o navegador por design —
# quem protege os dados e o RLS, nao o sigilo desta chave.
#
# NUNCA coloque a chave "service_role" aqui: NEXT_PUBLIC_* e embutida no
# bundle do cliente, e a service_role ignora todas as politicas de RLS.
